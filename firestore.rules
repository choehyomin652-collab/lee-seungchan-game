rules_version = '2';
// 영토체스 계정 서버 규칙: Firebase 콘솔 → Firestore Database → 규칙(Rules) 에 그대로 붙여 넣어요
// · 로그인한 사람은 모두의 프로필을 읽을 수 있어요 (친구들 순위)
// · 내 문서(users/내 uid)는 나만 쓸 수 있어요
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size() < 200000;
    }
  }
}
